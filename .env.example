# Firebase Web app configuration (public project identifiers; security is enforced by Firestore rules).
# Copy to .env.local after creating the Firebase project. Never put service-account credentials here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
